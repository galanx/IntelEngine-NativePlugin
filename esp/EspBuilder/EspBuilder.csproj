<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds the records IntelEngine 4.0 adds to IntelEngine.esp, from code (the esp has no other source).
       See README.md beside this file for how to run it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IntelEngine.EspBuilder</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mutagen.Bethesda.Skyrim" Version="0.52.0" />
  </ItemGroup>

</Project>
