# ===========================================
# IntelEngine-NativePlugin .gitignore
# ===========================================

# Data/ is a separate repo (IntelEngine-GamePlugin)
Data/

# CMake build output (massive — rebuild locally)
SKSE/build/

# Node.js dependencies (rebuild with npm install)
node_modules/

# Compiled PEX output (built from Source/Scripts/*.psc)
Output/

# Temp decompile directories
temp_decompile/
temp_decompiled/

# Windows NUL device artifact
nul

# Internal Discord promo files (not for repo)
README-discord*.md
RELEASE_PITCH.md

# Deprecated/backup verify scripts
_verify.ps1
_verify_prompt.ps1

# Visual Studio / IDE
*.user
*.suo
*.vs/
.vs/
*.sln.DotSettings.user

# OS artifacts
Thumbs.db
Desktop.ini
.DS_Store
tools/
check_header.ps1
check_backslash.ps1
SkyrimNet_API_Issues.log
CHANGELOG.md

SKSE/cmake/x64-windows-skse.cmake
